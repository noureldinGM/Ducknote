{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "pattern": "^[a-z0-9_]+$"
    },
    "displayName": {
      "type": "string",
      "maxLength": 50
    },
    "profileImage": {
      "type": "string"
    }
  },
  "required": [
    "username",
    "displayName",
    "profileImage"
  ]
}